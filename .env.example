# Local SQLite; optionally an absolute path
# DASHBOARD_DB=C:/path/dashboard.sqlite
# Set 0 for a truly empty offline database (historical demo seeds disabled)
# DASHBOARD_DEMO_SEED=0
# Optional read-only agent API key; use at least 32 random characters
AGENT_READ_API_KEY=

# Register a Native/PKCE EVE application at developers.eveonline.com
EVE_CLIENT_ID=
EVE_CALLBACK_URL=http://127.0.0.1:3000/api/auth/eve/callback
# Optional only for a confidential web application; native PKCE does not need it
EVE_CLIENT_SECRET=

# Generate locally with npm run secrets. Never commit .env.local.
TOKEN_ENCRYPTION_KEY=
APPLICATION_SECRET=

# Reviewed against CCP's OpenAPI on 2026-10-08; explicitly pinned
ESI_COMPATIBILITY_DATE=2026-08-18
ESI_USER_AGENT=Make-EvE-Free-Again/2.0 local-dashboard
EVE_SSO_SCOPES=esi-industry.read_character_mining.v1 esi-planets.manage_planets.v1 esi-wallet.read_character_wallet.v1 esi-industry.read_character_jobs.v1 esi-markets.read_character_orders.v1 esi-skills.read_skills.v1 esi-skills.read_skillqueue.v1 esi-clones.read_implants.v1 esi-assets.read_assets.v1 esi-contracts.read_character_contracts.v1

# Prepared private mode. Activate only after explicit production approval.
# DASHBOARD_ACCESS_MODE=private
# DASHBOARD_PUBLIC_ORIGIN=https://device.tailnet.ts.net
# DASHBOARD_ACCESS_USER=dashboard
# DASHBOARD_ACCESS_PASSWORD= (separate random secret, at least 32 characters)
# DASHBOARD_DATABASE_ROLE=primary
# DASHBOARD_DB=C:/local-production-data/dashboard.sqlite
