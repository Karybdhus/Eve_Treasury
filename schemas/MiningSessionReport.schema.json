{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "reportId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "period": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "to": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source": {
      "type": "string",
      "enum": [
        "agent",
        "manual",
        "motor_market",
        "esi",
        "buyback",
        "dashboard"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "actual",
        "plan",
        "estimate"
      ]
    },
    "currency": {
      "type": "string",
      "const": "ISK"
    },
    "reportingTimezone": {
      "type": "string",
      "enum": [
        "UTC",
        "Europe/Berlin"
      ]
    },
    "derivedNetProfit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        {
          "type": "number",
          "minimum": -90000000000000,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        }
      ]
    },
    "evidenceReferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceTransactionIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "string",
      "enum": [
        "live",
        "historical_seed"
      ]
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "pillar": {
      "type": "string",
      "const": "mining"
    },
    "reportType": {
      "type": "string",
      "const": "session"
    },
    "data": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "MiningSessionReport"
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "durationHours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "fleetHours": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "output": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "category": {
                "type": "string",
                "enum": [
                  "ice",
                  "ore",
                  "gas",
                  "pi",
                  "other"
                ]
              },
              "quantity": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "item",
              "category",
              "quantity",
              "unit"
            ],
            "additionalProperties": false
          }
        },
        "realizedRevenue": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 90000000000000,
              "multipleOf": 0.01
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "operatingCosts": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 90000000000000,
              "multipleOf": 0.01
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "internalTransfers": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
            },
            {
              "type": "number",
              "minimum": -90000000000000,
              "maximum": 90000000000000,
              "multipleOf": 0.01
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "plexPurchases": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 90000000000000,
              "multipleOf": 0.01
            },
            {
              "type": "string",
              "enum": [
                "unknown",
                "not_reported"
              ]
            }
          ]
        },
        "characters": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 100
              },
              "outputUnits": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "not_reported"
                    ]
                  }
                ]
              },
              "hours": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "enum": [
                      "unknown",
                      "not_reported"
                    ]
                  }
                ]
              }
            },
            "required": [
              "name",
              "outputUnits",
              "hours"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "sessionId",
        "durationHours",
        "fleetHours",
        "output",
        "realizedRevenue",
        "operatingCosts",
        "internalTransfers",
        "plexPurchases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "reportId",
    "period",
    "generatedAt",
    "source",
    "status",
    "currency",
    "provenance",
    "pillar",
    "reportType",
    "data"
  ],
  "additionalProperties": false
}
