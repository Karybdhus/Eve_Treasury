{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataQuality": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "plexContribution": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "fleetStart": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "fleetEnd": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "fleetHours": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        }
      ]
    },
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "outputQuantity": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_reported"
                ]
              }
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "typeId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "ice",
              "ore",
              "gas"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          }
        },
        "required": [
          "name",
          "quantity"
        ],
        "additionalProperties": {}
      }
    },
    "directCosts": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    }
  },
  "required": [
    "sessionId"
  ],
  "additionalProperties": {}
}
