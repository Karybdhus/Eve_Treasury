{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataQuality": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "plexContribution": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "realizedRevenue": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "netProfit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        },
        {
          "type": "number"
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        }
      ]
    },
    "characters": {
      "type": "array",
      "items": {}
    },
    "colonies": {
      "type": "array",
      "items": {}
    },
    "extractionCycles": {
      "type": "array",
      "items": {}
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "typeId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "enum": [
              "ice",
              "ore",
              "gas"
            ]
          },
          "quantity": {
            "type": "number",
            "minimum": 0
          },
          "unit": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3",
              "P4"
            ]
          }
        },
        "required": [
          "name",
          "quantity"
        ],
        "additionalProperties": {}
      }
    },
    "pocoTaxes": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "importExportCosts": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "inventorySnapshot": {
      "type": "array",
      "items": {}
    }
  },
  "additionalProperties": {}
}
