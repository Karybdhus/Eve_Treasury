{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataQuality": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "plexContribution": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
    "notes": {
      "type": "string"
    },
    "activities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "ratting",
              "hacking",
              "salvage",
              "other"
            ]
          },
          "grossRevenue": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 90000000000000,
                "multipleOf": 0.01
              },
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_reported"
                ]
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
              }
            ]
          },
          "directCosts": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 90000000000000,
                "multipleOf": 0.01
              },
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_reported"
                ]
              },
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
              }
            ]
          },
          "netProfit": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
              },
              {
                "type": "number"
              },
              {
                "type": "string",
                "enum": [
                  "unknown",
                  "not_reported"
                ]
              }
            ]
          },
          "sourceTransactionIds": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            }
          }
        },
        "required": [
          "category"
        ]
      }
    }
  },
  "additionalProperties": {}
}
