    "dataQuality": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "plexContribution": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 90000000000000,
          "multipleOf": 0.01
        },
        {
          "type": "string",
          "enum": [
            "unknown",
            "not_reported"
          ]
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,2})?$"
        }
      ]
    },
